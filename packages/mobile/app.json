{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.gospelplay_g7p2.runable",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "apiUrl": "https://gospelp-k90uuu4-preview-4200.runable.site/",
      "applicationId": "gospelp-k90uuu4",
      "runableAuthIssuer": "https://api.runable.com/api/auth"
    },
    "ios": {
      "bundleIdentifier": "com.gospelplay_g7p2.runable",
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "name": "Gospel Play",
    "slug": "gospel-play",
    "version": "1.0.0",
    "scheme": "runable-gospelp-k90uuu4",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o Gospel Play use sua localiza\u00e7\u00e3o para mostrar o clima da sua regi\u00e3o."
        }
      ]
    ]
  }
}